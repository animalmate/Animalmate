# 00 규칙 #4: 시크릿/개인정보 커밋 금지 — 아래 항목은 절대 커밋되면 안 된다.

# 환경 변수 / 시크릿
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# 백업 덤프 (PII 포함 — 평문 공개 금지, 02-TECH-STACK §3)
*.dump
*.sql.gz
*.sql.age
*.sql.gpg
backups/

# 의존성 / 빌드 산출물
node_modules/
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# 로그 / 임시
*.log
npm-debug.log*
.DS_Store
Thumbs.db
tmp/
.cache/

# 에디터
.vscode/
.idea/
*.swp

# 에이전트 도구 상태
.omc/
eval/results/

# 리포 루트의 화면 캡처 — 규칙 #4(개인정보 커밋 금지) 재발 방지.
# 면접 시간표 캡처(11.png·22.png)가 지원자·면접관 **실명이 보이는 채로** 루트에 커밋돼
# public 리포에 올라간 적이 있다. 캡처는 design/screenshots/ 에 두고, 사람 이름이 찍힌 것은
# 리포에 넣지 않는다(넣어야 하면 먼저 가린다).
/*.png
/*.jpg
/*.jpeg
/*.webp
